# AEKOS System Configuration

# JWT Authentication
JWT_SECRET=change-this-to-a-secure-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# PostgreSQL Database
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/aekos_db

# Knowledge Graph (Neo4j)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# Vector Database (ChromaDB)
CHROMA_PATH=./chroma_db

# Local LLM & Embeddings (Ollama & LangChain)
OLLAMA_URL=http://localhost:11434
LLM_MODEL=llama3
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# Connectors API Credentials
GITHUB_TOKEN=
JIRA_API_TOKEN=

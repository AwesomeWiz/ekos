# AEKOS System Configuration

# JWT Authentication
JWT_SECRET=change-this-to-a-secure-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Local SQLite database (replace with a PostgreSQL URL if needed)
POSTGRES_URL=sqlite:///./aekos.db

# Knowledge Graph (Neo4j)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# Vector Database (ChromaDB)
CHROMA_PATH=./data/chroma

# Local LLM & Embeddings (Ollama & LangChain)
OLLAMA_URL=http://localhost:11434
LLM_MODEL=qwen3:1.7b
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# GitHub integration (leave empty to seed a visible Not Configured record)
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
JIRA_API_TOKEN=
# JSON array of allowed frontend origins. Bearer tokens do not require cookies.
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
